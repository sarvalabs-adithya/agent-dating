{
  "gateway": {
    "mode": "local",
    "bind": "custom",
    "customBindHost": "0.0.0.0",
    "port": 18789,
    "auth": { "mode": "token", "token": "dating-loopback-a" },
    "nodes": { "pairing": { "autoApproveCidrs": ["127.0.0.1/32", "::1/128"] } }
  },

  "models": {
    "providers": {
      "groq": {
        "baseUrl": "https://api.groq.com/openai/v1",
        "apiKey": "${AGENT_A_GROQ_API_KEY}",
        "api": "openai-completions",
        "models": [{ "id": "llama-3.3-70b-versatile", "name": "Llama 3.3 70B" }]
      }
    }
  },

  "agents": {
    "defaults": {
      "model": { "primary": "groq/llama-3.3-70b-versatile" }
    }
  },

  "plugins": {
    "load": { "paths": ["/plugin"] },
    "entries": {
      "agent-dating": {
        "enabled": true,
        "config": {
          "moiMnemonic": "${AGENT_A_MOI_MNEMONIC}",
          "moiDerivationPath": "${MOI_DERIVATION_PATH}",
          "agentUrl": "${AGENT_A_URL}",
          "datingPeerOwner": "${AGENT_A_PEER_OWNER}",
          "useAgentBrain": true
        }
      }
    }
  },

  "tools": {
    "alsoAllow": ["dating_register", "dating_discover", "dating_send", "dating_verdict"]
  }
}
